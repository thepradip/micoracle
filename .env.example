# Copy this file to `.env` and edit the values. Everything is optional —
# leaving a variable unset falls back to sensible per-OS defaults.

# ───────────────────────── Backends ─────────────────────────
# STT_BACKEND:         local only — auto | mlx | faster  (continuous listening, free)
# COMMAND_STT_BACKEND: cloud, post-wake-word only — 60db | openai | azure | realtime
# TTS_BACKEND:         auto | say | pyttsx3 | openai | azure | none
#
# Cost-guard: any cloud backend set as STT_BACKEND is automatically demoted
# to COMMAND_STT_BACKEND; a local backend handles continuous listening instead.
#
# Recommended setup (Apple Silicon):
#   STT     = mlx   → local MLX Whisper for always-on wake-word detection (free)
#   COMMAND = 60db  → 60dB.ai only fires after wake word is confirmed (paid)
# VOICE_AGENT_STT_BACKEND=mlx
# VOICE_AGENT_COMMAND_STT_BACKEND=60db
# VOICE_AGENT_TTS_BACKEND=auto

# ───────────────────────── Pro license ──────────────────────
# Unlocks voice macros, custom wake words, and analytics export.
# Either set it here, or run:  micoracle license <KEY>  (persists it).
# MICORACLE_LICENSE=MICO1...

# ───────────────────────── Audio / target ───────────────────
# Mic device name fragment or numeric id (run --list-devices).
# VOICE_AGENT_INPUT_DEVICE=MacBook Pro Microphone
#
# Pin dispatch to a specific app. If unset, whatever is frontmost at startup
# is captured. On Wayland this variable is REQUIRED (no frontmost detection).
# Examples: Terminal, iTerm2, Claude, gnome-terminal, WindowsTerminal.exe
# VOICE_AGENT_TARGET_APP=Terminal

# ───────────────────────── Local STT knobs ──────────────────
# MLX Whisper model repo (Apple Silicon only).
VOICE_AGENT_MLX_REPO=mlx-community/whisper-medium.en-mlx-4bit

# faster-whisper tuning.
# Model name: tiny.en / base.en / small.en / medium.en / large-v3
VOICE_AGENT_FASTER_MODEL=small.en
# Device: auto / cpu / cuda
VOICE_AGENT_FASTER_DEVICE=auto
# Compute type: int8 (CPU-friendly) / float16 (GPU) / int8_float16
VOICE_AGENT_FASTER_COMPUTE=int8

# Faster HuggingFace downloads (one-time model pulls).
HF_HUB_ENABLE_HF_TRANSFER=1

# ───────────────────────── Cloud STT: 60dB.ai ───────────────
# Non-hallucinating, 39 languages, <300 ms. No extra pip packages needed.
# SIXTYDB_API_KEY=sk_live_...
# Language code (ISO 639-1). Use "auto" to detect automatically.
# VOICE_AGENT_SIXTYDB_LANGUAGE=en

# ───────────────────────── Cloud STT: ElevenLabs Scribe ─────
# 99 languages, speaker diarization, very high accuracy.
# ELEVENLABS_API_KEY=...
# VOICE_AGENT_ELEVENLABS_MODEL=scribe_v2      # or scribe_v1
# VOICE_AGENT_ELEVENLABS_LANGUAGE=en

# ───────────────────────── Cloud STT: Deepgram Nova ──────────
# Sub-300 ms, best for English/Spanish, smart formatting.
# DEEPGRAM_API_KEY=...
# VOICE_AGENT_DEEPGRAM_MODEL=nova-2           # or nova-3
# VOICE_AGENT_DEEPGRAM_LANGUAGE=en

# ───────────────────────── Cloud STT: AssemblyAI ─────────────
# Universal-2 model, async upload → poll pattern.
# ASSEMBLYAI_API_KEY=...
# VOICE_AGENT_ASSEMBLYAI_LANGUAGE=en

# ───────────────────────── Cloud STT: Groq Whisper ───────────
# Fastest Whisper inference (~200 ms), OpenAI-compatible endpoint.
# GROQ_API_KEY=...
# VOICE_AGENT_GROQ_MODEL=whisper-large-v3-turbo  # or whisper-large-v3
# VOICE_AGENT_GROQ_LANGUAGE=en

# ───────────────────────── Cloud STT: Gladia ─────────────────
# Async upload → poll, real-time capable, diarization.
# GLADIA_API_KEY=...

# ───────────────────────── Cloud STT: OpenAI ────────────────
# OPENAI_API_KEY=sk-...
# VOICE_AGENT_OPENAI_STT_MODEL=whisper-1

# ───────────────────────── Cloud STT: OpenAI Realtime ───────
# GPT-4o Realtime transcription (WebSocket). Requires: pip install websockets
# Uses OPENAI_API_KEY above.
# VOICE_AGENT_REALTIME_MODEL=gpt-4o-transcribe

# ───────────────────────── Cloud STT: Azure OpenAI ──────────
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_KEY=...
# AZURE_WHISPER_DEPLOYMENT=whisper

# ───────────────────────── Cloud TTS: OpenAI ────────────────
# Uses OPENAI_API_KEY above. Voices: alloy, echo, fable, onyx, nova, shimmer.
# VOICE_AGENT_OPENAI_TTS_VOICE=alloy

# ───────────────────────── Cloud TTS: Azure Speech ──────────
# Separate service from Azure OpenAI.
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=eastus
# VOICE_AGENT_AZURE_TTS_VOICE=en-US-AriaNeural

# ───────────────────────── Local TTS knobs ──────────────────
# macOS `say` voice name (e.g. "Ava (Premium)"). Leave unset for default.
# VOICE_AGENT_TTS_VOICE=Samantha
